#!/bin/bash
#PBS -N de_f2p
#PBS -q regular
#PBS -l nodes=1:ppn=8
#PBS -l walltime=03:00:00
#PBS -e ../../logs/
#PBS -o ../../logs/

set -Eeuo pipefail
cd "$PBS_O_WORKDIR"                      # submit from <repo>/scripts/pbs/
REPO=$(cd ../.. && pwd)
DATA_DIR="$REPO/data"
RES_DIR="$REPO/results"
LOG="$REPO/logs/log_${PBS_JOBID}"
mkdir -p "$REPO/logs" "$RES_DIR" "$REPO/paper/figures"

log() { echo "[$(date '+%F %T')] $*" | tee -a "$LOG"; }
handle_error() {
  local code=$?
  log "FAILED job=$PBS_JOBID host=$(hostname) line=$1 exit=$code time=$(date '+%F %T')"
  exit "$code"
}
trap 'handle_error $LINENO' ERR

# ---- EDIT PER JOB ----
MODULES=(anaconda3)
CONDA_ENV="/home/soumi/miniconda3/envs/darkedges"
REQUIRED_CMDS=(timeout python)
# ----------------------

source /etc/profile.d/modules.sh 2>/dev/null || true
for m in "${MODULES[@]}"; do
  module load "$m" && log "loaded module: $m"
done

if [[ -n "$CONDA_ENV" ]]; then
  source "$(conda info --base)/etc/profile.d/conda.sh"
  conda activate "$CONDA_ENV"
  log "conda env: $CONDA_ENV"
fi

for cmd in "${REQUIRED_CMDS[@]}"; do
  command -v "$cmd" >/dev/null || { log "missing dependency: $cmd"; exit 127; }
  log "$cmd -> $(command -v "$cmd")"
done
log "python $(python --version 2>&1); numpy/scipy/sklearn/pandas: $(python -c 'import numpy,scipy,sklearn,pandas;print(numpy.__version__,scipy.__version__,sklearn.__version__,pandas.__version__)')"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

[[ -s "$DATA_DIR/extras/gold_nodes.jsonl" ]] || { log "missing gold_nodes.jsonl"; exit 1; }
# Sensitivity run on the f2p task set in a separate root; data/ is shared via a symlink, results stay apart
F2P="$REPO/sens_f2p"
mkdir -p "$F2P/results" "$F2P/paper/figures"
ln -sfn "$REPO/data" "$F2P/data"
log "f2p sensitivity root: $F2P"
log "04 (f2p)";  timeout --foreground 10000 python "$REPO/scripts/04_compare_static.py" --root "$F2P" --task-set f2p 2>&1 | tee -a "$LOG"
log "05 (f2p)";  timeout --foreground 10000 python "$REPO/scripts/05_rankings.py" --root "$F2P" --task-set f2p --shuffles 100 2>&1 | tee -a "$LOG"
log "06 default"; timeout --foreground 10000 python "$REPO/scripts/06_linkpred.py" --root "$F2P" 2>&1 | tee -a "$LOG"
log "06 nohubs";  timeout --foreground 10000 python "$REPO/scripts/06_linkpred.py" --root "$F2P" --no-class-hubs --tag nohubs 2>&1 | tee -a "$LOG"
log "06 nohubs_crossclass"; timeout --foreground 10000 python "$REPO/scripts/06_linkpred.py" --root "$F2P" --no-class-hubs --exclude-same-class --tag nohubs_crossclass 2>&1 | tee -a "$LOG"
log "07";  timeout --foreground 3000 python "$REPO/scripts/07_stats_figures.py" --root "$F2P" --boot 10000 2>&1 | tee -a "$LOG"
[[ -s "$F2P/results/hypotheses_summary.md" ]] || { log "missing $F2P/results/hypotheses_summary.md"; exit 1; }
log "summary: $F2P/results/hypotheses_summary.md"
log "done"
